# =============================================================================
# FETRAG - Variables d'environnement (chapitre 39 du CDC)
# Copier en .env à la racine pour le développement local. Aucun secret en Git.
# Sur Vercel : renseigner les mêmes variables dans chaque projet (apps/web et apps/lms).
# =============================================================================

# --- Base de données PostgreSQL (Neon) --- obligatoire
DATABASE_URL="postgresql://user:password@host-pooler/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/neondb?sslmode=require"

# --- Authentification (Auth.js) --- obligatoire
# Générer avec : openssl rand -base64 32 (identique sur le site et le LMS pour le SSO)
AUTH_SECRET="change-me-32-bytes-base64"
AUTH_TRUST_HOST="true"
# Authentification locale email + mot de passe (comptes de recette). "false" quand un IdP OIDC est branché.
FEATURE_LOCAL_AUTH="true"

# --- URLs des applications --- obligatoire
APP_WEB_URL="http://localhost:3000"
APP_LMS_URL="http://localhost:3001"
NEXT_PUBLIC_APP_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_APP_LMS_URL="http://localhost:3001"

# --- Emails (Resend) --- obligatoire en production
# Sans RESEND_API_KEY ni SMTP_HOST, les emails sont seulement journalisés (fournisseur console).
RESEND_API_KEY=""
# Expéditeur : adresse d'un domaine vérifié chez Resend. Pour tester sans domaine : "FETRAG <onboarding@resend.dev>"
# (envois limités à l'adresse du compte Resend).
EMAIL_FROM="FETRAG <no-reply@fetrag.ga>"

# --- Stockage des fichiers --- local (dev) | vercel-blob (Vercel, créer un store Blob) | s3
STORAGE_PROVIDER="local"
BLOB_READ_WRITE_TOKEN=""

# --- Secrets techniques --- obligatoire
# Signature des webhooks de paiement (sandbox et PSP) : openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET="change-me"
# Protège GET /api/cron/jobs (Vercel Cron l'envoie automatiquement) : openssl rand -hex 32
CRON_SECRET="change-me"

# =============================================================================
# Options - à déclarer uniquement si nécessaire (valeurs par défaut sinon)
# =============================================================================
# SSO entre fetrag.ga et formation.fetrag.ga (domaines définitifs seulement)
# AUTH_COOKIE_DOMAIN=".fetrag.ga"
# Fournisseur d'identité OIDC (Keycloak, Zitadel, Auth0...) - ADR-002
# OIDC_ISSUER="" OIDC_CLIENT_ID="" OIDC_CLIENT_SECRET="" OIDC_DISPLAY_NAME="Compte FETRAG"
# Forcer le fournisseur email (sinon déduit : resend > smtp > console)
# EMAIL_PROVIDER="resend"
# SMTP à la place de Resend
# SMTP_HOST="" SMTP_PORT="587" SMTP_USER="" SMTP_PASSWORD=""
# Stockage S3 compatible (MinIO, Scaleway...)
# S3_ENDPOINT="" S3_REGION="eu-west-1" S3_BUCKET_PUBLIC="fetrag-public" S3_BUCKET_PRIVATE="fetrag-private" S3_ACCESS_KEY_ID="" S3_SECRET_ACCESS_KEY=""
# Prestataire de paiement : sandbox (défaut) | airtel-money | moov-money | stripe
# PAYMENT_PROVIDER="sandbox"
# Fonctionnalités (true par défaut)
# FEATURE_PAYMENTS="true" FEATURE_FORUMS="true" FEATURE_NEWSLETTER="true"
