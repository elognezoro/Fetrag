# ---------------------------------------------------------------------------
# FETRAG - Variables d'environnement (familles décrites au chapitre 39 du CDC)
# Copier en .env à la racine pour le développement local. Aucun secret en Git.
# ---------------------------------------------------------------------------

# --- Base de données PostgreSQL (Neon) ---
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host-direct/neondb?sslmode=require"

# --- Authentification (Auth.js) ---
# Générer avec : openssl rand -base64 32
AUTH_SECRET="change-me-32-bytes-base64"
AUTH_TRUST_HOST="true"
# Domaine de cookie partagé pour le SSO entre fetrag.ga et formation.fetrag.ga (laisser vide en local / vercel.app)
AUTH_COOKIE_DOMAIN=""
# Authentification locale email + mot de passe (démo / recette). Mettre "false" quand un IdP OIDC est branché.
FEATURE_LOCAL_AUTH="true"

# --- Fournisseur d'identité OIDC (optionnel : Keycloak, Zitadel, Auth0, Logto...) ---
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_DISPLAY_NAME="Compte FETRAG"

# --- URLs des applications ---
APP_WEB_URL="http://localhost:3000"
APP_LMS_URL="http://localhost:3001"
API_URL="http://localhost:3000/api/v1"
NEXT_PUBLIC_APP_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_APP_LMS_URL="http://localhost:3001"
NEXT_PUBLIC_SITE_NAME="FETRAG"

# --- Email (console | smtp) ---
EMAIL_PROVIDER="console"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="FETRAG <no-reply@fetrag.ga>"

# --- Stockage objet (local | vercel-blob | s3) ---
STORAGE_PROVIDER="local"
BLOB_READ_WRITE_TOKEN=""
S3_ENDPOINT=""
S3_REGION="eu-west-1"
S3_BUCKET_PUBLIC="fetrag-public"
S3_BUCKET_PRIVATE="fetrag-private"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Paiements (sandbox | airtel-money | moov-money | stripe) ---
PAYMENT_PROVIDER="sandbox"
PAYMENT_WEBHOOK_SECRET="change-me"

# --- Jobs asynchrones (Vercel Cron appelle /api/cron/jobs avec ce secret) ---
CRON_SECRET="change-me"

# --- Feature flags ---
FEATURE_PAYMENTS="true"
FEATURE_FORUMS="true"
FEATURE_NEWSLETTER="true"
