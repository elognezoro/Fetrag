{
  "name": "@fetrag/guides",
  "version": "0.1.0",
  "private": true,
  "description": "Guides d'utilisation par rôle (site institutionnel et plateforme de formation) : contenu structuré, catalogue et politique d'accès.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "lint": "eslint src scripts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "export:docs": "tsx scripts/export-markdown.ts"
  },
  "dependencies": {
    "@fetrag/contracts": "workspace:*",
    "@fetrag/db": "workspace:*",
    "@fetrag/domain": "workspace:*"
  },
  "devDependencies": {
    "@fetrag/eslint-config": "workspace:*",
    "@fetrag/tsconfig": "workspace:*",
    "@types/node": "^22.15.30",
    "eslint": "^9.28.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.2"
  }
}
