{
  "name": "@fetrag/api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST /v1 (Hono + Zod OpenAPI) montée dans les apps Next.js et dans apps/api.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "lint": "eslint src",
