    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fetrag/analytics": "workspace:*",
    "@fetrag/auth": "workspace:*",
    "@fetrag/cms": "workspace:*",
    "@fetrag/config": "workspace:*",
    "@fetrag/contracts": "workspace:*",
    "@fetrag/db": "workspace:*",
    "@fetrag/domain": "workspace:*",
    "@fetrag/jobs": "workspace:*",
    "@fetrag/lms-core": "workspace:*",
    "@fetrag/observability": "workspace:*",
    "@fetrag/payments": "workspace:*",
    "@fetrag/search": "workspace:*",
    "@hono/swagger-ui": "^0.5.1",
    "@hono/zod-openapi": "^0.19.8",
    "hono": "^4.7.11",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@fetrag/eslint-config": "workspace:*",
    "@fetrag/tsconfig": "workspace:*",
    "@types/node": "^22.15.30",
    "eslint": "^9.28.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.2"
  }
}
