# ---------------------------------------------------------------------------
# @fetrag/lms - variables d'environnement attendues (aucune valeur ici).
# En local, le fichier .env racine du monorepo est chargé par next.config.ts.
# Sur Vercel, déclarer ces variables dans le projet « lms ».
# ---------------------------------------------------------------------------

# Base de données PostgreSQL (Neon) : chaîne poolée + chaîne directe (migrations)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Authentification Auth.js (secret commun aux deux apps pour le SSO)
AUTH_SECRET=
AUTH_URL=
AUTH_TRUST_HOST=
AUTH_COOKIE_DOMAIN=
AUTH_ENFORCE_MFA=
FEATURE_LOCAL_AUTH=

# Fournisseur d'identité OIDC (optionnel)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISPLAY_NAME=

# URLs des applications (serveur) et variables publiques (client)
APP_WEB_URL=
APP_LMS_URL=
API_URL=
NEXT_PUBLIC_APP_WEB_URL=
NEXT_PUBLIC_APP_LMS_URL=
NEXT_PUBLIC_SITE_NAME=

# Email (console | smtp)
EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Stockage objet (local | vercel-blob | s3)
STORAGE_PROVIDER=
BLOB_READ_WRITE_TOKEN=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET_PUBLIC=
S3_BUCKET_PRIVATE=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Paiements (sandbox | airtel-money | moov-money | stripe)
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=

# Jobs asynchrones : Vercel Cron appelle GET /api/cron/jobs avec « Authorization: Bearer <CRON_SECRET> »
CRON_SECRET=

# Feature flags
FEATURE_PAYMENTS=
FEATURE_FORUMS=
FEATURE_NEWSLETTER=

# Observabilité
LOG_LEVEL=
SERVICE_NAME=
