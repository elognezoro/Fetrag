{
  "name": "@fetrag/api-server",
  "version": "0.1.0",
  "private": true,
  "description": "Serveur API autonome (Hono + Node) pour déploiement conteneurisé ; le même routeur est monté dans les apps Next.js sous /api/v1.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fetrag/api": "workspace:*",
    "@fetrag/config": "workspace:*",
    "@hono/node-server": "^1.14.3",
    "hono": "^4.7.11"
  },
  "devDependencies": {
    "@fetrag/eslint-config": "workspace:*",
    "@fetrag/tsconfig": "workspace:*",
    "@types/node": "^22.15.30",
    "eslint": "^9.28.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.2",
    "dotenv-cli": "^8.0.0",
    "tsx": "^4.19.4"
  }
}
