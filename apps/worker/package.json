{
  "name": "@fetrag/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Worker de jobs asynchrones (emails, certificats, webhooks, exports). Sur Vercel, le même processeur est appelé par Cron via /api/cron/jobs.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fetrag/config": "workspace:*",
    "@fetrag/db": "workspace:*",
    "@fetrag/jobs": "workspace:*",
    "@fetrag/notifications": "workspace:*",
    "@fetrag/observability": "workspace:*",
    "@fetrag/payments": "workspace:*"
  },
  "devDependencies": {
    "@fetrag/eslint-config": "workspace:*",
    "@fetrag/tsconfig": "workspace:*",
    "@types/node": "^22.15.30",
    "eslint": "^9.28.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.2",
    "dotenv-cli": "^8.0.0",
    "tsx": "^4.19.4"
  }
}
